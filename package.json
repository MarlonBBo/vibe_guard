{
  "name": "vibe-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static, deterministic repository reliability analysis.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "start": "node dist/app/server.js",
    "worker": "tsx src/workers/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=tap tests/**/*.test.ts",
    "build": "tsc",
    "migrate": "node-pg-migrate"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
